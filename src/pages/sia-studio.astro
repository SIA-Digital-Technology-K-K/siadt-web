---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductFacts from '../components/ProductFacts.astro';
import { productSchema, products } from '../data/site';

const studioUrl = 'https://studio.siadt.jp/';
const product = products.find((p) => p.name === 'SIA Studio')!;
const faqs = [
  {
    q: 'SIA Studioはどの会社の製品ですか？',
    a: 'SIA Studioは、SIAデジタルテクノロジー株式会社（SIA Digital Technology Co., Ltd.、https://siadt.jp/）が企画・開発・提供するAIクリエイティブツールです。製品サイトは https://studio.siadt.jp/ です。',
  },
  {
    q: 'SIA Studioで何ができますか？',
    a: 'プロンプトから画像・動画・文章を生成できます。ガイド機能では、目的を選ぶだけで文案・画像・短尺動画をまとめて作成できます。',
  },
  {
    q: 'SIA Studioは無料で使えますか？',
    a: '現在、https://studio.siadt.jp/ から無料で試せます。料金プランの詳細は製品サイトでご確認ください。',
  },
  {
    q: '生成した画像や文章は商用利用できますか？',
    a: '利用規約および適用法令の範囲内で、商用目的を含む利用が可能です。公開・商用利用前に、内容・表現・権利関係をご自身で確認してください。',
  },
];
---

<Base
  title="SIA Studio｜SIAデジタルテクノロジーのAIクリエイティブツール"
  description="SIA Studioは、SIAデジタルテクノロジー株式会社が提供するAIクリエイティブツールです。プロンプトから画像・動画・文章を生成し、ガイド機能で一括作成できます。公式サイト studio.siadt.jp。"
  keywords="SIA Studio,AI画像生成,AI動画生成,AI文章生成,AIクリエイティブツール,SIAデジタルテクノロジー"
  ogImage="/images/sia-studio-hero.png"
  jsonLd={productSchema({ product, faqs })}
>
  <PageHero title="SIA Studio" />
  <main class="mx-auto max-w-4xl px-4 py-14">
    <div class="prose-body">
      <figure class="!mt-0 !mb-8 text-center">
        <img
          src="/images/sia-studio-hero.png"
          alt="SIA Studio — プロンプトから画像・動画・文章を生成するAIクリエイティブツール"
          class="mx-auto w-full max-w-4xl rounded-xl shadow-sm"
          width="1024"
          height="682"
          loading="eager"
        />
      </figure>

      <div class="my-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href={studioUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-solid !no-underline"
        >
          今すぐ無料で試す
        </a>
        <a href="/inquiries/" class="btn btn-accent !no-underline">サービスについて相談する</a>
      </div>

      <p class="text-lg font-semibold !text-gray-900">
        プロンプトから、画像・動画・文章を生成できるAIクリエイティブツール。
      </p>

      <h2>アイデアを、AIですばやく形に。</h2>
      <p>
        SIA Studioは、プロンプトを入力するだけで、画像・動画・文章を生成できるAIクリエイティブツールです。
      </p>
      <p>
        企画から素材制作までの流れをひとつにまとめ、日々のコンテンツ制作をサポートします。
      </p>

      <h2>新機能：目的を選ぶだけで、必要なコンテンツを一括生成</h2>
      <p>
        ガイド機能では、作りたい目的を選ぶだけで、文案・画像・短尺動画をまとめて生成できます。
        AIに詳しくなくても、目的から成果物までの流れを進められます。
      </p>
      <p>たとえば、次のような目的から始められます。</p>
      <ul>
        <li>会社案内・信頼獲得</li>
        <li>商品・サービスの紹介</li>
        <li>SNSや広告向けの素材作成</li>
      </ul>
      <p>入力できる内容は、次のとおりです。</p>
      <ul>
        <li>社名・製品名</li>
        <li>伝えたいこと・根拠・希望する見せ方</li>
        <li>想定読者</li>
        <li>ロゴなどのブランド素材（任意）</li>
      </ul>
      <p>一括生成では、次の成果物をまとめて作成します。</p>
      <ol>
        <li>企画パック</li>
        <li>文案</li>
        <li>画像</li>
        <li>短尺動画</li>
      </ol>
      <p>
        入力内容は「AIで整理」で整えたうえで、必要に応じて手直しできます。
        生成結果は確認のうえ、ご利用ください。
      </p>

      <figure class="!my-10 text-center">
        <img
          src="/images/sia-studio-guide.png"
          alt="SIA Studioのガイド機能。目的を選ぶだけで、文案・画像・短尺動画をまとめて生成"
          class="mx-auto w-full max-w-4xl rounded-xl border border-gray-200 shadow-sm"
          width="1536"
          height="1024"
          loading="lazy"
        />
        <figcaption class="!mt-3 text-sm !text-gray-500">
          目的を選ぶだけで、企画・文案・画像・短尺動画をまとめて作成できます。
        </figcaption>
      </figure>

      <div class="my-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href={studioUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-solid !no-underline"
        >
          ガイドで一括生成する
        </a>
      </div>

      <h2>主な機能</h2>
      <p>
        用途に応じたAI生成機能を、ひとつのサービスから利用できます。
      </p>

      <h3>AI画像生成</h3>
      <p>
        作りたいイメージを文章で入力すると、AIが内容に沿った画像を生成します。
      </p>
      <p>たとえば、次のような用途に活用できます。</p>
      <ul>
        <li>Webサイト用画像</li>
        <li>SNS投稿用画像</li>
        <li>広告素材</li>
        <li>イメージビジュアル</li>
        <li>企画案の参考画像</li>
      </ul>

      <h3>AI動画生成</h3>
      <p>
        プロンプトや素材をもとに、動画コンテンツの制作をサポートします。
        生成後は進捗を確認し、MP4としてダウンロードできます。
      </p>
      <p>たとえば、次のような用途に活用できます。</p>
      <ul>
        <li>短いプロモーション動画</li>
        <li>SNS向け動画素材</li>
        <li>サービス紹介用動画</li>
      </ul>

      <h3>AI文章生成</h3>
      <p>
        用途やテーマを入力すると、AIが文案制作をサポートします。
        生成した文章は、確認のうえダウンロードしてご利用いただけます。
      </p>
      <p>たとえば、次のような用途に活用できます。</p>
      <ul>
        <li>SNS投稿文</li>
        <li>広告文案</li>
        <li>商品・サービス紹介文</li>
        <li>Webサイト掲載文</li>
        <li>企画案</li>
      </ul>

      <h2>ご利用の流れ</h2>
      <ol>
        <li><strong>目的を選ぶ、または作成したい内容を選ぶ</strong> — ガイドから一括生成するか、画像・動画・文章を個別に作成します。</li>
        <li><strong>内容を入力する</strong> — 社名、伝えたいこと、想定読者、またはプロンプトを入力します。</li>
        <li><strong>AIがコンテンツを生成する</strong> — 入力内容に沿って、素材や文案を生成します。</li>
        <li><strong>内容を確認して利用する</strong> — 生成結果を確認し、ダウンロードしてご活用ください。</li>
      </ol>

      <h2>SIA Studioの特長</h2>
      <ul>
        <li>目的を選ぶだけで、文案・画像・短尺動画をまとめて生成できる</li>
        <li>画像、動画、文章の生成をひとつの画面で利用できる</li>
        <li>専門的な制作ソフトを使わずに素材作成を始められる</li>
        <li>アイデアや企画を短時間でビジュアル化できる</li>
        <li>日本語のプロンプトで利用できる</li>
        <li>さまざまなコンテンツ制作の初稿作成に活用できる</li>
      </ul>

      <h2>活用シーン</h2>
      <p>
        日々のコンテンツ制作における、素材づくりや初稿作成に活用いただけます。
      </p>
      <ul>
        <li>会社案内やサービス紹介の初稿作成</li>
        <li>Webサイトの素材作成</li>
        <li>SNS投稿の制作</li>
        <li>広告クリエイティブの作成</li>
        <li>企画書や提案資料の素材作成</li>
        <li>動画コンテンツのアイデア作成</li>
      </ul>

      <h2>生成コンテンツについて</h2>
      <p>
        生成結果はそのまま使用せず、内容、表現、権利関係などをご確認のうえご利用ください。
      </p>
      <p>
        生成コンテンツは、<a href="https://studio.siadt.jp/terms.html" target="_blank" rel="noopener">利用規約</a>および適用法令の範囲内で、商用目的を含む利用が可能です。ただし、意図せず第三者の権利を侵害する可能性もあるため、公開・商用利用にあたってはご自身の責任と判断でご確認ください。
      </p>

      <h2>よくある質問</h2>
      {
        faqs.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))
      }

      <h2>画像・動画・文章の制作を、もっと手軽に。</h2>
      <p>
        目的を選ぶだけで、必要なコンテンツをまとめて作成できます。SIA Studioで、アイデアをコンテンツに変えてみませんか。
      </p>
      <div class="my-12 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href={studioUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-solid !no-underline"
        >
          今すぐ無料で試す
        </a>
        <a href="/inquiries/" class="btn btn-accent !no-underline">お問い合わせ</a>
      </div>

      <section class="product-entity" aria-label="製品の基本情報">
        <p>
          SIA Studioは、<a href="/企業情報/">SIAデジタルテクノロジー株式会社</a>が提供するAIクリエイティブツールです。公式サイトは
          <a href={studioUrl} target="_blank" rel="noopener">studio.siadt.jp</a>。
        </p>
        <ProductFacts
          caption="SIA Studio の基本情報"
          facts={[
            { term: '提供元', text: 'SIAデジタルテクノロジー株式会社', href: '/企業情報/' },
            { term: '公式サイト', text: 'https://studio.siadt.jp/', href: studioUrl, external: true },
            { term: 'できること', text: 'プロンプトからの画像生成、動画生成、文章生成。ガイドによる文案・画像・短尺動画の一括生成' },
            { term: 'できないこと', text: '生成結果の権利・事実関係の保証、公開判断の代行、専門制作ソフトの完全代替' },
            { term: '対象ユーザー', text: '企業の広報・マーケ、中小企業、SNSや広告素材を作る担当者' },
            { term: '利用料金', text: '無料で試用可能。詳細は製品サイトを参照' },
            { term: '商用利用', text: '利用規約と法令の範囲内で可能。公開前の確認は利用者の責任' },
            { term: '対応言語', text: '日本語のプロンプトで利用可能' },
          ]}
        />
      </section>
    </div>
  </main>
</Base>
