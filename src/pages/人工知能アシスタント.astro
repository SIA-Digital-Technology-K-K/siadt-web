---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductFacts from '../components/ProductFacts.astro';
import { productSchema, products } from '../data/site';

const productUrl = 'https://assist.siadt.jp/';
const product = products.find((p) => p.name === 'SIA AI Assist')!;
const faqs = [
  {
    q: 'SIA AI Assistはどの会社の製品ですか？',
    a: 'SIA AI Assistは、SIAデジタルテクノロジー株式会社（SIA Digital Technology Co., Ltd.）が提供する社内AIワークスペースです。製品サイトは https://assist.siadt.jp/ です。',
  },
  {
    q: 'どのような業務に使えますか？',
    a: '社内検索、数値分析、文書作成、報告資料の構成、議事整理、日報・週報作成、税務・財務相談、市場調査、翻訳、ウェブ調査などに対応しています。定型業務カードを選ぶか、自由に相談できます。',
  },
  {
    q: '導入形態は選べますか？',
    a: 'クラウド版（月額課金）、オンプレミス版（買い切り）、自社モデル利用（モデル差し替え）から、企業のセキュリティ方針に合わせて選べる設計です。',
  },
  {
    q: '社内データは外部に送信されますか？',
    a: 'オンプレミス版および自社モデル利用では、社内データが当社を含む外部に送信されません。クラウド版は当社が運用する環境でご利用いただけます。',
  },
];

const features = [
  { title: '社内検索', desc: '社内の資料や情報を探す' },
  { title: '数値分析', desc: '数字を読み解き整理する' },
  { title: '文書作成', desc: '各種文書のたたき台を作る' },
  { title: '報告資料', desc: '報告資料の構成を組み立てる' },
  { title: '議事整理', desc: '打ち合わせ内容を整理する' },
  { title: '日報作成', desc: '日々の記録をまとめる' },
  { title: '週報作成', desc: '週次の報告をまとめる' },
  { title: '税務・財務', desc: '税務・財務まわりの相談' },
  { title: '市場調査', desc: '市場や競合の情報を調べる' },
  { title: '翻訳', desc: '文書や文面の翻訳を支援' },
  { title: 'ウェブ調査', desc: '公開情報の調査を支援' },
];

const deployments = [
  {
    badge: '月額課金',
    title: 'クラウド版',
    desc: '当社が運用するクラウド環境をそのままご利用いただけます。サーバーの用意が不要で、すぐに使い始められます。',
    points: ['初期費用を抑えて開始', '運用・保守は当社が担当', '機能追加を自動で反映'],
  },
  {
    badge: '買い切り',
    title: 'オンプレミス版',
    desc: 'ソフトウェアを買い切りでご購入いただき、貴社のサーバー環境に導入します。データが社外に出ません。',
    points: ['自社環境内で完結', '社内ネットワークで運用', '月額費用が発生しない'],
  },
  {
    badge: 'モデル差し替え',
    title: '自社モデル利用',
    desc: '貴社で契約・構築済みのAIモデルに差し替えてご利用いただけます。既存のAI投資をそのまま活かせます。',
    points: ['利用するモデルを指定可能', '既存のAI基盤と併用', '社内方針に沿った運用'],
  },
];
---

<Base
  title="SIA AI Assist｜SIAデジタルテクノロジーの社内AIワークスペース"
  description="SIA AI Assistは、SIAデジタルテクノロジー株式会社が提供する社内AIワークスペースです。社内検索・数値分析・文書作成などを一つの画面から。公式サイト assist.siadt.jp。"
  keywords="SIA AI Assist,社内AI,AIアシスタント,ナレッジベース,社内検索,文書作成,オンプレミスAI,SIAデジタルテクノロジー"
  ogImage="/images/sia-ai-assist-hero.png"
  jsonLd={productSchema({ product, faqs })}
>
  <PageHero title="SIA AI Assist" />

  <main class="mx-auto max-w-4xl px-4 py-14">
    <div class="prose-body">
      <h2 class="!mt-0">仕事の相談を、いつでも。</h2>
      <p>
        社内業務のためのAIアシスタント。少人数の会社が、事務作業に取られる時間を減らすことを狙っています。
        社内検索、数値分析、文書・報告資料の作成などを一つの画面から進められます。
      </p>

      <div class="my-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href={productUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-solid !no-underline"
        >
          今すぐ無料で試す
        </a>
        <a href="/inquiries/" class="btn btn-accent !no-underline">お問い合わせ</a>
      </div>

      <figure class="!my-8 text-center">
        <img
          src="/images/sia-ai-assist-hero.png"
          alt="SIA AI Assist — 社内AIワークスペースのホーム画面"
          class="mx-auto w-full max-w-4xl rounded-xl border border-gray-200 shadow-sm"
          width="1440"
          height="900"
          loading="lazy"
        />
        <figcaption class="!mt-3 text-sm !text-gray-500">
          実際の操作画面：進行中の作業と完了成果を本週・本月で確認できます。
        </figcaption>
      </figure>

      <p class="text-lg font-semibold !text-gray-900">
        社内データを扱うツールだからこそ、導入形態を選べる設計です。
      </p>
      <p>
        SIA AI Assistは、定型業務カードを選ぶと目的に合わせて応答する社内AIワークスペースです。
        作業ごとに文脈を保存し、続きから再開できます。社内ナレッジを登録すると、AI回答時に参照されます。
      </p>

      <h2>主な機能</h2>
      <div class="not-prose my-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <div class="rounded-xl border border-gray-200 bg-white px-4 py-4">
              <p class="font-semibold text-gray-900">{f.title}</p>
              <p class="mt-1 text-sm text-gray-600">{f.desc}</p>
            </div>
          ))
        }
      </div>

      <h2>社内ナレッジ</h2>
      <p>
        ファイルまたはテキストを登録すると、AI回答時に参照されます。
        公開範囲を全社または部署限定に設定でき、分析用データセットとしても登録できます。
      </p>

      <h2>選べる導入形態</h2>
      <p>
        企業ごとのセキュリティ方針に合わせて、導入方法を選べる設計にしています。
      </p>
      <div class="not-prose my-8 grid gap-4 md:grid-cols-3">
        {
          deployments.map((d) => (
            <div class="rounded-xl border border-gray-200 bg-surface px-5 py-6">
              <p class="text-xs font-bold tracking-wide text-accent">{d.badge}</p>
              <h3 class="mt-2 text-lg font-bold text-gray-900">{d.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-gray-600">{d.desc}</p>
              <ul class="mt-4 space-y-1.5 text-sm text-gray-700">
                {d.points.map((p) => (
                  <li class="flex gap-2">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <figure class="!my-8 text-center">
        <img
          src="/images/sia-ai-assist-deploy.jpg"
          alt="SIA AI Assistの導入形態 — クラウド版・オンプレミス版・自社モデル利用"
          class="mx-auto w-full max-w-4xl rounded-xl border border-gray-200 shadow-sm"
          width="1600"
          height="900"
          loading="lazy"
        />
      </figure>
      <p class="rounded-lg border border-gray-200 bg-surface px-4 py-3 text-sm !leading-relaxed">
        オンプレミス版および自社モデル利用では、社内データが当社を含む外部に送信されません。機密性の高い情報を扱う業務でもご利用いただけます。
      </p>

      <h2>このような場面でご活用いただけます</h2>
      <ul>
        <li>社内資料の検索や確認に時間がかかっている企業</li>
        <li>日報・週報・議事録などの定型文書を効率化したい企業</li>
        <li>少人数で事務作業の負担が大きい会社</li>
        <li>データを社外に出したくない企業</li>
        <li>既存のAIモデル投資を活かしたい企業</li>
      </ul>

      <h2>よくある質問</h2>
      {
        faqs.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))
      }

      <section class="mt-16 rounded-2xl bg-surface px-6 py-12 text-center md:px-10">
        <h2 class="!mt-0 text-2xl font-bold text-gray-900 md:text-3xl">仕事の相談を、いつでも。</h2>
        <p class="mx-auto mt-4 max-w-xl text-gray-600">
          社内検索から文書作成、ナレッジ参照まで。
          SIA AI Assistが、少人数の会社の事務作業をサポートします。
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={productUrl}
            target="_blank"
            rel="noopener"
            class="btn btn-solid !no-underline"
          >
            今すぐ無料で試す
          </a>
          <a href="/inquiries/" class="btn btn-accent !text-ink !border-ink hover:!bg-ink hover:!text-white !no-underline">
            お問い合わせ
          </a>
        </div>
      </section>

      <section class="product-entity" aria-label="製品の基本情報">
        <p>
          SIA AI Assistは、<a href="/企業情報/">SIAデジタルテクノロジー株式会社</a>が提供する社内AIワークスペースです。公式サイトは
          <a href={productUrl} target="_blank" rel="noopener">assist.siadt.jp</a>。
        </p>
        <ProductFacts
          caption="SIA AI Assist の基本情報"
          facts={[
            { term: '提供元', text: 'SIAデジタルテクノロジー株式会社', href: '/企業情報/' },
            { term: '公式サイト', text: 'https://assist.siadt.jp/', href: productUrl, external: true },
            { term: 'できること', text: '社内検索、数値分析、文書・報告資料の作成、議事や日報の整理、ナレッジ参照' },
            { term: '導入形態', text: 'クラウド／オンプレミス／自社モデル' },
            { term: '対象ユーザー', text: 'データを社外に出したくない企業、少人数の中小企業' },
            { term: '利用料金', text: 'クラウド版は無料で試用可能' },
          ]}
        />
      </section>
    </div>
  </main>
</Base>
