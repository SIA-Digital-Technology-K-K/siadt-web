---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="技術提携パートナー｜SIA Digital Technology" description="SIAデジタルテクノロジーの技術提携パートナー。AI・クラウド・ハードウェア領域で協業する企業各社をご紹介します。">
  <PageHero title="技術提携パートナー" />
  <main class="mx-auto max-w-5xl px-4 py-14">
    <p class="mb-8 text-center leading-relaxed text-gray-600">
      AI・クラウド・エッジハードウェアなどの領域で、SIAデジタルテクノロジーが協業する技術提携パートナーです。共同開発や導入支援を通じて、現場で使えるデジタルソリューションを届けます。
    </p>
    <figure class="my-8">
      <img src="/images/partner_logos_final.webp" alt="技術提携パートナー各社のロゴ" class="w-full" width="1024" height="96" loading="lazy" />
    </figure>
  </main>
</Base>
