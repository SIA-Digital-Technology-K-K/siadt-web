---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import products from '../data/products.json';
import { organization, siteUrl } from '../data/site';

const tokushohoUrl = `${siteUrl}/特定商取引法に基づく表記/`;

const storeJsonLd = products.map((p) => ({
  '@type': 'Product',
  '@id': `${siteUrl}/オンラインストア/#${p.id}`,
  name: p.name,
  description: `${p.name}。${p.features.join('、')}。${p.warranty}`,
  image: `${siteUrl}${p.image}`,
  sku: p.id,
  brand: {
    '@type': 'Brand',
    name: 'SIAデジタルテクノロジー',
    url: siteUrl,
    logo: organization.logo,
  },
  manufacturer: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: organization.name,
  },
  offers: {
    '@type': 'Offer',
    url: p.stripePaymentLink === 'STRIPE_LINK_TODO' ? `${siteUrl}/オンラインストア/` : p.stripePaymentLink,
    priceCurrency: 'JPY',
    price: String(p.price),
    priceValidUntil: '2027-12-31',
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    seller: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: organization.name,
    },
    // 特定商取引法表記に基づく送料・配送（1万円以上で送料無料／発送は営業日2〜7日）
    shippingDetails: {
      '@type': 'OfferShippingDetails',
      shippingRate: {
        '@type': 'MonetaryAmount',
        value: '0',
        currency: 'JPY',
      },
      shippingDestination: {
        '@type': 'DefinedRegion',
        addressCountry: 'JP',
      },
      deliveryTime: {
        '@type': 'ShippingDeliveryTime',
        handlingTime: {
          '@type': 'QuantitativeValue',
          minValue: 2,
          maxValue: 7,
          unitCode: 'DAY',
        },
        transitTime: {
          '@type': 'QuantitativeValue',
          minValue: 1,
          maxValue: 5,
          unitCode: 'DAY',
        },
      },
    },
    // 特定商取引法表記に基づく返品ポリシー（お届けから14日以内・返送料はお客様負担）
    hasMerchantReturnPolicy: {
      '@type': 'MerchantReturnPolicy',
      applicableCountry: 'JP',
      returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
      merchantReturnDays: 14,
      returnMethod: 'https://schema.org/ReturnByMail',
      returnFees: 'https://schema.org/ReturnFeesCustomerResponsibility',
      refundType: 'https://schema.org/FullRefund',
      returnPolicyCountry: 'JP',
      merchantReturnLink: tokushohoUrl,
    },
  },
}));
---

<Base
  title="オンラインストア｜AI自動給餌器 – SIA Digital Technology"
  description="SIAデジタルテクノロジーのオンラインストア。AI搭載の自動給餌器など個人向け製品をStripe決済で購入できます。大阪発送、特定商取引法表記あり。"
  jsonLd={storeJsonLd}
>
  <PageHero title="オンラインストア" />
  <main class="mx-auto max-w-5xl px-4 py-14">
    <div class="grid gap-8 md:grid-cols-2">
      {
        products.map((p) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border border-gray-200 shadow-sm">
            <img src={p.image} alt={p.name} class="aspect-square w-full object-cover" width="600" height="600" loading="lazy" />
            <div class="flex flex-1 flex-col p-6">
              <h2 class="text-xl font-bold text-gray-900">{p.name}</h2>
              <p class="mt-2 text-2xl font-bold text-[#0bbbb5]">{p.priceDisplay}</p>
              <div class="mt-4">
                <h3 class="text-sm font-bold text-gray-700">製品紹介</h3>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-gray-600">
                  {p.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
                <p class="mt-3 text-sm italic text-gray-600">{p.warranty}</p>
              </div>
              <div class="mt-auto pt-6">
                {p.stripePaymentLink === 'STRIPE_LINK_TODO' ? (
                  <span
                    class="block cursor-not-allowed rounded-xl bg-gray-300 py-3.5 text-center font-bold text-gray-600"
                    title="決済リンク準備中"
                    data-stripe-link-placeholder={p.id}
                  >
                    購入する（準備中）
                  </span>
                ) : (
                  <a
                    href={p.stripePaymentLink}
                    class="btn btn-solid block w-full text-center !rounded-xl"
                  >
                    購入する
                  </a>
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-12 text-center text-sm text-gray-500">
      お支払いはクレジットカード決済（Stripe）をご利用いただけます。ご購入前に<a href="/特定商取引法に基づく表記/" class="underline">特定商取引法に基づく表記</a>および<a href="/プライバシーポリシー/" class="underline">プライバシーポリシー</a>をご確認ください。
      1万円以上のご注文は送料無料、通常はご注文受付後営業日2～7日以内に発送いたします。
    </p>
  </main>
</Base>
