---
import Base from '../layouts/Base.astro';
import { faqSchema, products, siteUrl } from '../data/site';

const productCards = [
  {
    icon: '/images/service-img3.webp',
    label: 'SIA 帳場',
    blurb: '領収書・請求書から仕訳と帳簿を自動生成するAI経理。',
    note: '特願2026-215614出願中 ／ IT導入支援事業者採択',
    href: '/sia-choba/',
  },
  {
    icon: '/images/service-img2.webp',
    label: 'SIA TalentEye',
    blurb: 'PDF・Word履歴書を解析し候補者比較を支援するAI採用。',
    note: '特願2026-210115出願中',
    href: '/sia-talenteye/',
  },
  {
    icon: '/images/service-img4.webp',
    label: 'SIA AI Assist',
    blurb: '社内検索・分析・文書作成を一画面で行う社内AI基盤。',
    note: '特願2026-210114出願中 ／ クラウド・オンプレ対応',
    href: '/人工知能アシスタント/',
  },
  {
    icon: '/images/service-img1.webp',
    label: 'SIA Studio',
    blurb: 'プロンプトから画像・短尺動画・文章を一括生成。',
    note: '法人・個人向け生成AI制作ツール',
    href: '/sia-studio/',
  },
  {
    icon: '/images/service-engawa.webp',
    label: '緣側（えんがわ）',
    blurb: '自然なAI会話を通じて高齢者の日々の安否を見守る支援サービス。',
    note: '日本国 特許第7917241号（登録済）実装プロダクト',
    href: 'https://engawa-app.jp/',
    external: true,
    highlight: true,
  },
  {
    icon: '/images/service-nihontsu.webp',
    label: '日本通（Nihontsu）',
    blurb: '交通運行・災害速報・行政案内などの公式情報を多言語で集約。',
    note: '在日外国人向け公式生活情報サービス（登録不要・無料）',
    href: 'https://livein-japan.com/',
    external: true,
  },
];

const industrySolutions = [
  {
    target: '創業期・中小企業全般向け',
    title: '中小企業向けIT基盤・段階的DX整備',
    desc: '公式サイト制作（税込49,000円〜）、ドメイン・法人メール設定、キャッシュレス決済・EC導入、業務システム開発。',
    href: '/中小企業向けIT基盤サービス/',
  },
  {
    target: '小売店・商業施設向け',
    title: '既設カメラ活用の防犯・客流AI解析',
    desc: '既存の防犯カメラ設備をそのまま活かし、万引き不審行動の即時通知と匿名化された来店属性・滞在時間を可視化。',
    href: '/shop/',
  },
  {
    target: '自動車販売店・ディーラー向け',
    title: 'ショールーム来店動線・注目車種分析',
    desc: '小型AIエッジサーバー（最大6台カメラ接続）で、展示車の注目度ランキング・ヒートマップ・遠隔巡回を実現。',
    href: '/car/',
  },
  {
    target: 'EC・店舗・法人決済向け',
    title: '企業金融・キャッシュレス決済技術サービス',
    desc: 'PayPay・Alipay・WeChat Pay等のマルチ決済導入・システム連携をはじめ、企業金融に関わるIT技術基盤を実務支援。',
    href: '/企業金融技術服務/',
  },
];

const clientVoices = [
  {
    industry: '専門商社・卸売業',
    meta: '大阪府 ／ 従業員15名規模 ／ 管理部門ご担当者様',
    solution: 'AI経理「SIA 帳場」',
    solutionHref: '/sia-choba/',
    challenge: '紙の領収書とPDF請求書が混在し、毎月末の手入力と勘定科目の確認作業に多くの時間を取られていた。',
    voice:
      '既存の会計ソフトを無理に入れ替えるのではなく、今の運用を残したまま証憑の読み取りと仕訳の下書きから試せたのが現実的でした。IT専任者がいない社内でも画面が分かりやすく、月次の経理確認負担が確実に軽くなっています。',
    result: '月次の証憑整理・仕訳入力にかかる確認工数を大幅に削減',
  },
  {
    industry: '小売・専門店運営',
    meta: '関西圏・複数店舗展開 ／ 店舗運営統括責任者様',
    solution: '小売店舗向けAI解析システム',
    solutionHref: '/shop/',
    challenge: '防犯カメラは設置済みだったが録画を見返す余裕がなく、万引き対策や時間帯別の客流把握が現場の勘頼みになっていた。',
    voice:
      'カメラ設備を一式入れ替えると初期投資が合わないと悩んでいましたが、既設カメラをそのまま活かしてエッジ側で解析する構成を提案いただきました。個人を特定せずプライバシーに配慮しながら混雑時間帯や動線が数値で見えるようになり、売場改善の議論が具体的になりました。',
    result: '既設カメラ流用で初期費用を抑え、防犯通知と客流データ可視化を実現',
  },
  {
    industry: '貿易・サービス業（新設法人）',
    meta: '大阪府 ／ 従業員8名規模 ／ 代表取締役様',
    solution: '中小企業IT基盤整備・社内AI導入',
    solutionHref: '/中小企業向けIT基盤サービス/',
    challenge: '創業後の公式サイト・法人メール等の基礎IT整備と、少人数でのバックオフィス業務効率化を同時に進める必要があった。',
    voice:
      '専門用語を並べるのではなく、当社の事業規模と予算に合わせて「今すぐ整えるべき基盤」と「後から段階的に導入するAIツール」を明確に切り分けてくれました。料金体系も最初から税込で明示されており、導入後のちょっとした運用相談にも丁寧に対応してもらえるので心強く感じています。',
    result: '約1ヶ月でコーポレートIT基盤を整備し、少人数体制での定型事務を省力化',
  },
];

const techPartners = [
  { name: 'DeepEleph（深象智能）', img: '/images/partner-deepeleph.webp' },
  { name: 'Chosen Technology', img: '/images/partner-chosen.webp' },
  { name: 'Emdoor DIGI', img: '/images/partner-emdoor.webp' },
];

const homeFaqs = [
  {
    q: 'SIAデジタルテクノロジー株式会社はどのような製品・サービスを提供していますか？',
    a: '大阪市住之江区に本社を置くAI・DX開発企業（法人番号：3120001247658）です。AI経理「SIA 帳場」（特願2026-215614）、AI採用「SIA TalentEye」（特願2026-210115）、社内AI「SIA AI Assist」（特願2026-210114）、生成AI制作「SIA Studio」、高齢者見守りAI「緣側」（特許第7917241号）、多言語公式情報サービス「日本通」、および現場設置型エッジAI製品を自社開発・提供しています。',
  },
  {
    q: '社内にITやAIの専任担当者がいなくても導入できますか？',
    a: 'はい。ご相談いただく企業様の多くはIT専任者が不在の中小企業様です。紙・電話・Excel中心の業務環境や既設カメラ設備を活かしながら、現場に無理なく定着する段階的なデジタル化をご提案いたします。',
  },
  {
    q: '補助金を活用した導入や、データを社外に出さないオンプレミス運用は可能ですか？',
    a: '当社は「中小企業デジタル化・AI導入支援事業費補助金」のIT導入支援事業者（登録番号：ITP07-0006526）に採択されており、対象製品の補助金活用相談に対応しています。また、社内AI「SIA AI Assist」の買い切りオンプレミス版や、カメラ映像を外部送信しないエッジAIサーバーも選択可能です。',
  },
  {
    q: '初回相談や見積りに費用はかかりますか？対応エリアはどこですか？',
    a: '初回のご相談・ヒアリング・概算お見積りは無料です。大阪市住之江区の本社（TEL：06-4400-2968）を拠点に関西圏での対面打ち合わせはもちろん、オンラインにて日本全国の企業様に対応しております（日本語・中国語対応）。',
  },
];

const homeJsonLd = [
  {
    '@type': 'ItemList',
    '@id': `${siteUrl}/#featured-products`,
    name: 'SIAデジタルテクノロジー株式会社 自社開発AI製品一覧',
    itemListElement: products.map((p, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: p.name,
      url: p.url,
      description: p.description,
    })),
  },
  faqSchema(homeFaqs),
];
---

<Base
  title="SIAデジタルテクノロジー株式会社｜大阪の自社開発AIプロダクト・中小企業DX支援"
  description="大阪市住之江区のSIAデジタルテクノロジー株式会社（法人番号3120001247658）。特許第7917241号登録済・IT導入支援事業者採択済（ITP07-0006526）。AI経理「SIA帳場」、AI採用「SIA TalentEye」、社内AI「SIA AI Assist」、生成AI「SIA Studio」、高齢者見守りAI「緣側」、店舗エッジAIを開発・提供。"
  keywords="SIAデジタルテクノロジー,SIA Digital Technology,大阪 AI開発,中小企業DX,SIA帳場,AI経理,SIA TalentEye,AI採用,SIA Studio,SIA AI Assist,緣側,見守りAI 特許,エッジAI,IT導入支援事業者"
  jsonLd={homeJsonLd}
>
  <main class="bg-ink text-white">
    <!-- 1. Hero（頂部メイン画像は維持、H1に明確な事業・地域キーワードを配置） -->
    <section class="relative flex min-h-[560px] items-end overflow-hidden md:min-h-[680px] md:items-center">
      <img
        src="/images/hero-robot-girl.webp"
        alt="大阪発の自社開発AIプロダクトと中小企業DX支援 — SIAデジタルテクノロジー株式会社"
        class="absolute inset-0 h-full w-full object-cover object-center"
        width="1024"
        height="1024"
        fetchpriority="high"
      />
      <div
        class="absolute inset-0"
        style="background:linear-gradient(to top,rgba(4,0,10,0.92) 0%,rgba(4,0,10,0.6) 46%,rgba(4,0,10,0.24) 100%)"
        aria-hidden="true"
      ></div>
      <div class="relative z-10 mx-auto w-full max-w-6xl px-4 pb-16 pt-40 md:pb-20 md:pt-24">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold tracking-wider text-accent">
            日本の伝統を守り、日本の未来を創る — SIA Digital Technology
          </p>
          <h1 class="mt-3 text-[1.75rem] font-bold leading-snug text-white sm:text-4xl md:text-[2.5rem]">
            大阪発・自社開発<span class="text-accent whitespace-nowrap">AIプロダクト</span>と<br />中小企業の段階的<span class="text-accent">DX支援</span>
          </h1>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-gray-200 sm:text-base">
            AI経理・AI採用・社内AI・生成AI制作・高齢者見守りAIから店舗エッジ解析まで、IT専任者がいない現場でも無理なく定着するシステムを開発・提供しています。
          </p>
          <div class="mt-8">
            <a href="/inquiries/" class="btn btn-accent">無料相談・お問い合わせ</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. 公的認定・知的財産・セキュリティ・国内法人エビデンス -->
    <section aria-label="公的認定・知的財産・セキュリティ体制" class="border-y border-white/10 bg-panel/90">
      <div class="mx-auto max-w-6xl px-4 py-8">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <a
            href="/sia-choba/#it-support-provider"
            class="group flex flex-col justify-between rounded-xl border border-white/10 bg-ink/80 p-4 transition hover:border-accent/60"
          >
            <div>
              <span class="inline-block rounded bg-accent/15 px-2 py-0.5 text-[11px] font-bold text-accent">
                公的補助金制度 採択済
              </span>
              <h2 class="mt-2 text-sm font-bold text-white group-hover:text-accent">
                IT導入支援事業者 採択
              </h2>
              <p class="mt-1 text-xs leading-relaxed text-gray-300">
                中小企業デジタル化・AI導入支援事業費補助金（登録番号：ITP07-0006526）
              </p>
            </div>
            <span class="mt-3 text-[11px] font-semibold text-accent">採択通知書を確認 →</span>
          </a>

          <a
            href="/知的財産/"
            class="group flex flex-col justify-between rounded-xl border border-white/10 bg-ink/80 p-4 transition hover:border-accent/60"
          >
            <div>
              <span class="inline-block rounded bg-accent/15 px-2 py-0.5 text-[11px] font-bold text-accent">
                自社R&amp;D・知的財産
              </span>
              <h2 class="mt-2 text-sm font-bold text-white group-hover:text-accent">
                特許第7917241号 ほか知財4件
              </h2>
              <p class="mt-1 text-xs leading-relaxed text-gray-300">
                見守りAIで登録特許1件保有、業務AI領域で計3件を特許庁へ出願中
              </p>
            </div>
            <span class="mt-3 text-[11px] font-semibold text-accent">特許証・出願一覧を確認 →</span>
          </a>

          <a
            href="/security-policy/"
            class="group flex flex-col justify-between rounded-xl border border-white/10 bg-ink/80 p-4 transition hover:border-accent/60"
          >
            <div class="flex items-start justify-between gap-2">
              <div>
                <span class="inline-block rounded bg-accent/15 px-2 py-0.5 text-[11px] font-bold text-accent">
                  情報セキュリティ宣言
                </span>
                <h2 class="mt-2 text-sm font-bold text-white group-hover:text-accent">
                  IPA SECURITY ACTION 二つ星
                </h2>
              </div>
              <img
                src="/images/security-action-two-star.png"
                alt="IPA SECURITY ACTION 二つ星"
                width="38"
                height="38"
                class="h-9 w-9 shrink-0 rounded-xs bg-white p-0.5 object-contain"
                loading="lazy"
              />
            </div>
            <p class="mt-1 text-xs leading-relaxed text-gray-300">
              情報セキュリティ基本方針を策定・公開。オンプレミス・エッジ運用にも対応
            </p>
            <span class="mt-3 text-[11px] font-semibold text-accent">基本方針を確認 →</span>
          </a>

          <a
            href="/企業情報/"
            class="group flex flex-col justify-between rounded-xl border border-white/10 bg-ink/80 p-4 transition hover:border-accent/60"
          >
            <div>
              <span class="inline-block rounded bg-accent/15 px-2 py-0.5 text-[11px] font-bold text-accent">
                日本国内法人・大阪本社
              </span>
              <h2 class="mt-2 text-sm font-bold text-white group-hover:text-accent">
                大阪市住之江区・2022年7月設立
              </h2>
              <p class="mt-1 text-xs leading-relaxed text-gray-300">
                法人番号：3120001247658 ／ 税込料金・特定商取引法表記を明示
              </p>
            </div>
            <span class="mt-3 text-[11px] font-semibold text-accent">会社概要を確認 →</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 3A. 製品から探す：自社開発AIプロダクト（特許・出願技術との対応を明確化） -->
    <section class="relative overflow-hidden bg-black py-20">
      <img src="/images/service-img5.webp" alt="" class="absolute inset-0 h-full w-full object-cover opacity-50" loading="lazy" aria-hidden="true" />
      <div class="relative z-10 mx-auto max-w-6xl px-4">
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div>
            <p class="text-xs font-semibold tracking-widest text-accent uppercase">AI Products — 製品から探す</p>
            <h2 class="mt-2 text-2xl font-bold text-white md:text-3xl">
              自社開発AIプロダクト一覧
            </h2>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-gray-300">
              当社が独自に企画・研究開発しているソフトウェアおよびエッジAIハードウェア製品です。登録特許および特許出願技術を実務プロダクトとして実装しています。
            </p>
          </div>
          <a href="/製品情報/" class="shrink-0 text-sm font-semibold text-accent hover:underline">
            製品情報一覧ページへ →
          </a>
        </div>

        <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            productCards.map((p) => (
              <a
                href={p.href}
                target={p.external ? '_blank' : undefined}
                rel={p.external ? 'noopener' : undefined}
                class:list={[
                  'group flex flex-col justify-between rounded-xl border p-6 transition hover:-translate-y-0.5',
                  p.highlight
                    ? 'border-accent/50 hover:border-accent'
                    : 'border-white/12 hover:border-accent/50',
                ]}
                style="background:linear-gradient(225deg,rgb(22,22,26) 60%,rgba(101,252,242,0.22) 100%)"
              >
                <div>
                  <div class="flex items-center justify-between gap-3">
                    <img src={p.icon} alt="" class="h-9 w-9 rounded object-contain" width="36" height="36" loading="lazy" aria-hidden="true" />
                    <span class="text-xs font-medium text-accent">
                      {p.external ? '公式サイト ↗' : '詳細 →'}
                    </span>
                  </div>
                  <h3 class="mt-4 text-lg font-bold text-white group-hover:text-accent">{p.label}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-gray-200">{p.blurb}</p>
                </div>
                <p class="mt-4 border-t border-white/10 pt-3 text-[11px] font-medium text-gray-400">
                  {p.note}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 3B. 業種・課題から探す：現場別の導入支援ソリューション（製品ブロックと明確に役割を分離） -->
    <section class="border-y border-white/10 bg-panel/60 py-16">
      <div class="mx-auto max-w-6xl px-4">
        <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
          <div>
            <p class="text-xs font-semibold tracking-widest text-accent uppercase">Solutions by Industry — 業種・課題から探す</p>
            <h2 class="mt-1 text-xl font-bold text-white md:text-2xl">
              業種・現場課題別の導入支援プラン
            </h2>
            <p class="mt-1.5 text-sm text-gray-300">
              「何からデジタル化すべきか迷っている」企業様向けに、業種・フェーズ別の実践支援メニューをご用意しています。
            </p>
          </div>
          <a href="/ソリューション紹介/" class="shrink-0 text-sm font-semibold text-accent hover:underline">
            サービス分野一覧へ →
          </a>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            industrySolutions.map((s) => (
              <a
                href={s.href}
                class="group flex flex-col justify-between rounded-xl border border-white/10 bg-ink p-5 transition hover:border-accent/60"
              >
                <div>
                  <span class="text-[11px] font-bold text-accent">{s.target}</span>
                  <h3 class="mt-1 text-base font-bold text-white group-hover:text-accent">{s.title}</h3>
                  <p class="mt-2 text-xs leading-relaxed text-gray-300">{s.desc}</p>
                </div>
                <span class="mt-3 text-xs font-semibold text-gray-400 group-hover:text-accent">
                  プラン内容・料金を見る →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 4. 導入・ご相談企業様の声 ＋ 実名公開の技術提携パートナー -->
    <section class="mx-auto max-w-6xl px-4 py-20">
      <div class="grid gap-6 md:grid-cols-2 md:items-end">
        <div>
          <p class="text-xs font-semibold tracking-widest text-accent uppercase">Voice &amp; Partners</p>
          <h2 class="mt-2 text-2xl font-bold text-white md:text-3xl">
            ご導入・ご相談企業様の声
          </h2>
        </div>
        <p class="text-sm leading-relaxed text-gray-300">
          IT専任者がいない企業様や、既存設備・現在の業務手順を活かしながら段階的にデジタル化を進めたい経営者様・実務担当者様からのお声です。
        </p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          clientVoices.map((item) => (
