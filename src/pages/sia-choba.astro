---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProductFacts from '../components/ProductFacts.astro';
import { productSchema, products, siteUrl } from '../data/site';

const productUrl = 'https://choba.siadt.jp/';
const product = products.find((p) => p.name === 'SIA帳場')!;
const faqs = [
  {
    q: 'SIA帳場はどの会社の製品ですか？',
    a: 'SIA帳場は、SIAデジタルテクノロジー株式会社（SIA Digital Technology Co., Ltd.）が提供する中小企業向けAI経理プラットフォームです。製品サイトは https://choba.siadt.jp/ です。',
  },
  {
    q: '既存の会計ソフトをやめないと使えませんか？',
    a: '会計ソフトの乗り換えは必須ではありません。弥生会計、freee、マネーフォワード クラウド会計、勘定奉行などへの連携とCSV出力を目指しています。',
  },
  {
    q: '税理士の代わりになりますか？',
    a: 'なりません。仕訳・帳簿の下書きと財務・税務の質問回答を支援します。最終的な税務判断は利用者または専門家が行ってください。',
  },
  {
    q: '補助金を使って導入できますか？',
    a: '当社は中小企業デジタル化・AI導入支援事業費補助金におけるIT導入支援事業者として採択されています（採択通知日：2026年10月19日）。補助対象や申請可否は制度・審査結果により異なりますので、導入前にご相談ください。採択通知書: https://siadt.jp/files/中小企業デジタル化AI導入支援_IT導入支援事業者採択通知書.pdf',
  },
  {
    q: 'IT導入支援事業者とは何ですか？',
    a: '中小企業デジタル化・AI導入支援事業費補助金において、補助事業者（導入企業）の申請・報告などを支援する登録事業者です。当社は審査の結果、IT導入支援事業者として採択されました。',
  },
];

const itSupportNoticePdf = '/files/中小企業デジタル化AI導入支援_IT導入支援事業者採択通知書.pdf';
const itSupportNoticePdfAbs = `${siteUrl}${itSupportNoticePdf}`;
const pageUrl = `${siteUrl}/sia-choba/`;

const jsonLd = [
  ...productSchema({ product, faqs }),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'SIA帳場', item: pageUrl },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'IT導入支援事業者採択',
        item: `${pageUrl}#it-support-provider`,
      },
    ],
  },
  {
    '@type': 'DigitalDocument',
    '@id': `${itSupportNoticePdfAbs}#document`,
    name: '中小企業デジタル化・AI導入支援事業費補助金 IT導入支援事業者 採択通知書',
    description:
      'ＳＩＡデジタルテクノロジー株式会社が、中小企業デジタル化・ＡＩ導入支援事業費補助金におけるIT導入支援事業者として採択されたことを示す通知書（通知日：2026年10月19日、登録番号：ITP07-0006526）。',
    encodingFormat: 'application/pdf',
    url: itSupportNoticePdfAbs,
    datePublished: '2026-10-19',
    identifier: 'ITP07-0006526',
    inLanguage: 'ja',
    about: [{ '@id': product.id }, { '@id': `${siteUrl}/#organization` }],
    author: {
      '@type': 'Organization',
      name: '中小企業デジタル化・ＡＩ導入支援事業費補助金事務局',
    },
  },
];
---

<Base
  title="SIA帳場｜AI経理・IT導入支援事業者採択｜SIAデジタルテクノロジー"
  description="SIA帳場は領収書・請求書から仕訳と帳簿を自動生成する中小企業向けAI経理。提供元SIAデジタルテクノロジーは中小企業デジタル化・AI導入支援事業費補助金のIT導入支援事業者として採択済み（2026年10月19日）。"
  keywords="SIA帳場,AI経理,自動記帳,AI仕訳,領収書OCR,会計ソフト連携,財務税務アシスタント,中小企業経理,IT導入支援事業者,中小企業デジタル化AI導入支援事業費補助金,補助金,採択通知"
  ogImage="/images/sia-choba-hero.png"
  jsonLd={jsonLd}
>
  <PageHero title="SIA帳場" />

  <main class="mx-auto max-w-4xl px-4 py-14">
    <div class="prose-body">
      <h2 class="!mt-0">AIが、経理担当者になる。</h2>
      <p>
        領収書・請求書・銀行明細をアップロードするだけ。
        AIが仕訳を作成し、帳簿を自動生成。
        財務・税務の質問にも回答し、主要な日本会計ソフトとスムーズに連携します。
        提供元は中小企業デジタル化・AI導入支援事業費補助金の
        <a href="#it-support-provider">IT導入支援事業者として採択</a>されています。
      </p>

      <div class="my-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href={productUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-solid !no-underline"
        >
          無料で試す
        </a>
        <a
          href={productUrl}
          target="_blank"
          rel="noopener"
          class="btn btn-accent !no-underline"
        >
          デモを見る
        </a>
      </div>

      <figure class="!my-8 text-center">
        <img
          src="/images/sia-choba-hero.png"
          alt="SIA帳場 — AIが、経理担当者になる"
          class="mx-auto w-full max-w-4xl rounded-xl shadow-sm"
          width="1024"
          height="682"
          loading="lazy"
        />
      </figure>

      <p class="text-lg font-semibold !text-gray-900">
        中小企業の経理を、もっとシンプルに。
      </p>
      <p>
        SIA帳場は、AIによる自動記帳・財務税務アシスタント・会計ソフト連携をひとつにまとめた、中小企業向けAI経理プラットフォームです。
      </p>

      <h2>なぜSIA帳場を選ぶのか</h2>
      <h3>AIが経理業務をまるごとサポート</h3>
      <p>
        日々の記帳から帳簿作成、財務・税務相談まで、AIが24時間サポート。
        経理担当者の負担を大幅に軽減します。
      </p>

      <h2>主な機能</h2>

      <h3>1. AI財務・税務アシスタント</h3>
      <p>
        日本の会計・税務に特化したAIが、経理・税務に関する疑問へ迅速に回答します。
      </p>
      <p><strong>対応例</strong></p>
      <ul>
        <li>この経費は計上できますか？</li>
        <li>どの勘定科目になりますか？</li>
        <li>インボイス制度について知りたい</li>
        <li>消費税の考え方を教えて</li>
        <li>法人税の概算を知りたい</li>
        <li>減価償却の処理方法は？</li>
      </ul>

      <h3>2. AIが領収書・請求書を自動読取</h3>
      <p>
        画像・PDFをアップロードするだけ。
        AIが内容を解析し、必要な情報を自動抽出します。
      </p>
      <p><strong>対応データ</strong></p>
      <ul>
        <li>領収書</li>
        <li>請求書</li>
        <li>レシート</li>
        <li>銀行明細</li>
        <li>PDF / JPG / PNG</li>
      </ul>

      <h3>3. AI自動記帳</h3>
      <p>
        アップロードされたデータからAIが仕訳を自動生成。
        記帳業務を効率化し、入力作業を最小限にします。
      </p>
      <p><strong>自動処理</strong></p>
      <ul>
        <li>OCR読み取り</li>
        <li>仕訳作成</li>
        <li>勘定科目判定</li>
        <li>税区分判定</li>
        <li>重複チェック</li>
        <li>帳簿生成</li>
      </ul>

      <h3>4. 会計ソフト連携</h3>
      <p>
        現在利用している会計ソフトを変更する必要はありません。
        生成した仕訳データをスムーズに取り込みできます。
      </p>
      <p><strong>対応予定</strong></p>
      <ul>
        <li>弥生会計</li>
        <li>freee</li>
        <li>マネーフォワード クラウド会計</li>
        <li>勘定奉行</li>
        <li>CSV出力</li>
      </ul>

      <h2>ご利用の流れ</h2>
      <p>わずか4ステップで経理が完了</p>
      <ol>
        <li>領収書・請求書・銀行明細をアップロード</li>
        <li>AIが内容を解析</li>
        <li>AIが仕訳・帳簿を作成</li>
        <li>会計ソフトへ連携・出力</li>
      </ol>

      <figure class="!my-10 text-center">
        <img
          src="/images/sia-choba-infographic.png"
          alt="SIA帳場の利用ステップ — アップロードから帳簿生成・会計ソフト連携まで"
          class="mx-auto w-full max-w-4xl rounded-xl border border-gray-200 shadow-sm"
          width="1024"
          height="682"
          loading="lazy"
        />
      </figure>

      <h2>AIが自動で生成する帳簿</h2>
      <p>
        AIはアップロードされたデータをもとに、必要な会計帳簿を自動生成します。
      </p>
      <p><strong>出力例</strong></p>
      <ul>
        <li>仕訳帳</li>
        <li>総勘定元帳</li>
        <li>現金出納帳</li>
        <li>売掛帳</li>
        <li>買掛帳</li>
        <li>試算表</li>
      </ul>

      <h2>経営数字を、ひと目で。</h2>
      <p>
        毎日の経営状況をダッシュボードで確認できます。
      </p>
      <ul>
        <li>売上</li>
        <li>利益</li>
        <li>経費</li>
        <li>資金残高</li>
        <li>売掛金</li>
        <li>買掛金</li>
      </ul>

      <h2>AI財務アドバイザー</h2>
      <p>
        帳簿を作るだけではありません。
        AIが会社の数字を分析し、利益・資金繰り・税負担をわかりやすく可視化。
        経営判断をサポートします。
      </p>

      <h2>人ではなく、AIが24時間対応</h2>
      <p>
        経理担当者が休みでも、税理士との打ち合わせを待つ必要もありません。
        必要なときに、いつでもAIへ相談できます。
      </p>

      <h2>安心して利用できるセキュリティ</h2>
      <p>
        企業データを安全に管理するため、クラウド環境で適切なセキュリティ対策を実施しています。
        アップロードされたデータは暗号化して保存されます。
      </p>

      <h2 id="it-support-provider">補助金対応：IT導入支援事業者として採択</h2>
      <p>
        ＳＩＡデジタルテクノロジー株式会社は、中小企業デジタル化・ＡＩ導入支援事業費補助金における
        <strong>IT導入支援事業者</strong>として採択されました（採択通知日：2026年10月19日、登録番号：ITP07-0006526）。
        SIA帳場をはじめとするAI・DX導入をご検討の中小企業様は、補助金制度の活用についてもご相談いただけます。
      </p>
      <p>
        補助対象範囲や申請可否は、制度の要件および審査結果により異なります。詳細は
        <a href="/inquiries/">お問い合わせ</a>ください。
      </p>
      <ul>
        <li>制度名：中小企業デジタル化・ＡＩ導入支援事業費補助金</li>
        <li>区分：IT導入支援事業者 採択</li>
        <li>採択通知日：2026年10月19日</li>
        <li>登録番号：ITP07-0006526</li>
        <li>法人番号：3120001247658</li>
        <li>関連製品：<a href="https://choba.siadt.jp/" target="_blank" rel="noopener">SIA帳場</a>（AI経理）</li>
      </ul>
      <object
        data={itSupportNoticePdf}
        type="application/pdf"
        style="width:100%;height:640px"
        aria-label="中小企業デジタル化・AI導入支援事業費補助金 IT導入支援事業者 採択通知書（PDF）"
      >
        <p>PDFを表示できない場合は、下のリンクからダウンロードしてください。</p>
      </object>
      <p class="mt-4">
        <a href={itSupportNoticePdf}>IT導入支援事業者 採択通知書（PDF）</a>
        <a href={itSupportNoticePdf} download class="btn-download ml-4 !no-underline">ダウンロード</a>
      </p>

      <h2>このようなお客様におすすめ</h2>
      <ul>
        <li>経理担当者がいない企業</li>
        <li>少人数で経営している会社</li>
        <li>記帳代行コストを削減したい企業</li>
        <li>紙の領収書管理に時間がかかっている企業</li>
        <li>会計ソフトへの入力を効率化したい企業</li>
        <li>補助金を活用してAI経理・DXを進めたい中小企業</li>
      </ul>

      <h2>よくある質問</h2>
      {
        faqs.map((f) => (
          <>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </>
        ))
      }

      <h2>日本の中小企業に、AIという新しい経理担当者を。</h2>
      <p>
        SIA帳場は、AIを活用して経理業務を効率化し、中小企業が本来の事業に集中できる環境づくりを目指しています。
      </p>

      <section class="mt-16 rounded-2xl bg-surface px-6 py-12 text-center md:px-10">
        <h2 class="!mt-0 text-2xl font-bold text-gray-900 md:text-3xl">AIが、経理担当者になる。</h2>
        <p class="mx-auto mt-4 max-w-xl text-gray-600">
          領収書から帳簿作成、財務・税務サポートまで。
          SIA帳場が、中小企業の経理をもっとシンプルに。
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={productUrl}
            target="_blank"
            rel="noopener"
            class="btn btn-solid !no-underline"
          >
            無料で試す
          </a>
          <a href="/inquiries/" class="btn btn-accent !text-ink !border-ink hover:!bg-ink hover:!text-white !no-underline">
            お問い合わせ
          </a>
        </div>
      </section>

      <section class="product-entity" aria-label="製品の基本情報">
        <p>
          SIA帳場は、<a href="/企業情報/">SIAデジタルテクノロジー株式会社</a>が提供する中小企業向けAI経理プラットフォームです。公式サイトは
          <a href={productUrl} target="_blank" rel="noopener">choba.siadt.jp</a>。
        </p>
        <ProductFacts
          caption="SIA帳場 の基本情報"
          facts={[
            { term: '提供元', text: 'SIAデジタルテクノロジー株式会社', href: '/企業情報/' },
            { term: '公式サイト', text: 'https://choba.siadt.jp/', href: productUrl, external: true },
            { term: 'できること', text: '領収書・請求書・銀行明細の読取、仕訳と帳簿の自動生成、財務・税務の質問回答' },
            { term: 'できないこと', text: '税理士業務の代行、税務申告の確定、仕訳結果の無確認利用' },
            { term: '対応データ', text: '領収書、請求書、レシート、銀行明細（PDF / JPG / PNG）' },
            { term: '連携予定', text: '弥生会計、freee、マネーフォワード クラウド会計、勘定奉行、CSV' },
            { term: '対象ユーザー', text: '経理担当が少ない中小企業' },
            { term: '利用料金', text: '無料で試用可能' },
            {
              term: '補助金',
              text: '中小企業デジタル化・AI導入支援事業費補助金のIT導入支援事業者として採択（2026年10月19日）',
              href: itSupportNoticePdf,
              external: true,
            },
          ]}
        />
      </section>
    </div>
  </main>
</Base>
